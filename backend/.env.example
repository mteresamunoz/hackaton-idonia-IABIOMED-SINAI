# .env — Hackathon IABiomed 2026
# Copy this file to .env and fill in your real values.

# ── Idonia ────────────────────────────────────────
IDONIA_API_KEY=YOUR_IDONIA_API_KEY
IDONIA_API_SECRET=YOUR_IDONIA_API_SECRET
IDONIA_BASE_URL=https://connect-staging.idonia.com

# Endpoint suffix received after activation 
IDONIA_NUM_PARTICIPANTE=YOUR_PARTICIPANT_NUMBER

# Magic Link ID received from Idonia
IDONIA_ML_ID=YOUR_MAGIC_LINK_ID

# ── Recog ─────────────────────────────────────────
RECOG_API_KEY=YOUR_RECOG_API_KEY
RECOG_BASE_URL=https://api.recog.es
RECOG_ENDPOINT=/relisten/dictation/process/report-results


# ── Agente de corrección de errores (LLM / API OpenAI) ──
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_NAME=gpt-4o
MULTILINGUAL_MODEL_NAME=gpt-4o
